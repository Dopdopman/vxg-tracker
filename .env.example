# ==============================================================================
# VXG-TRACKER ENVIRONMENT TEMPLATE
# Copy to .env for local Docker Compose execution: cp .env.example .env
# ==============================================================================

# Runtime environment (development | production)
# When APP_ENV=production, ADMIN_API_KEY MUST be >= 24 random characters and non-default.
APP_ENV=development

# Mandatory timezone lock (UTC+7 Vietnam)
TZ=Asia/Ho_Chi_Minh
PGTZ=Asia/Ho_Chi_Minh

# PostgreSQL (Docker Compose defaults)
POSTGRES_USER=vxg
POSTGRES_PASSWORD=vxg_dev_password
POSTGRES_DB=vxg_tracker
POSTGRES_PORT=5432

# Backend & Worker DB URLs (for host execution replace @postgres with @localhost)
DATABASE_URL=postgresql+asyncpg://vxg:vxg_dev_password@postgres:5432/vxg_tracker
DATABASE_URL_SYNC=postgresql+psycopg://vxg:vxg_dev_password@postgres:5432/vxg_tracker

# FastAPI Server
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
API_CORS_ORIGINS=http://localhost:3000

# Admin endpoint security (POST /api/v1/admin/crawl-runs)
# SECURITY RULE: NEVER prefix this with NEXT_PUBLIC_ or commit a real secret!
ADMIN_API_KEY=change-me-local-admin-key

# Scraper, Retention & Alerting
WORKER_POLL_INTERVAL_SECONDS=5
PRICE_SPIKE_THRESHOLD_PCT=15.0
SNAPSHOT_RETENTION_DAYS=90
SCRAPER_HTTP_PROXY=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_DISCORD_WEBHOOK_URL=
HEALTHCHECKS_PING_URL=

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
INTERNAL_API_URL=http://api:8000
INTERNAL_API_BASE_URL=http://api:8000

