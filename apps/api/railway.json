{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/api/Dockerfile",
    "watchPatterns": [
      "apps/api/**",
      "packages/shared-py/**"
    ]
  },
  "deploy": {
    "preDeployCommand": "alembic -c /app/packages/shared-py/alembic.ini upgrade head && python -m vxg_shared.db.seed",
    "startCommand": "sh -c 'exec uvicorn vxg_api.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips=*'",
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}

