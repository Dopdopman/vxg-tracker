{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/worker/Dockerfile",
    "watchPatterns": [
      "apps/worker/**",
      "packages/shared-py/**"
    ]
  },
  "deploy": {
    "startCommand": "python -m vxg_worker.main",
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 10
  }
}

